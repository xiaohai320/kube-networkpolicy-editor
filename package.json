{
  "name": "network-policy-editor",
  "private": true,
  "version": "0.2.0",
  "description": "Browser-based visual editor for Kubernetes NetworkPolicy and Cilium CiliumNetworkPolicy",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "i18next": "^25.10.10",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.7.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
